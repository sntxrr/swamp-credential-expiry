# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section

# Local test models. This repo publishes an extension, not a deployment, and
# the model instances created here to exercise it against a real Apprise server
# carry internal hostnames and config keys. The extension bundle never includes
# them -- only manifest-declared files ship -- but this repo is public, so keep
# them out of git too.
models/**/*.yaml

# Local test models. This repo publishes an extension, not a deployment; the
# instances created here to exercise it carry real credential ids and vault
# names. The bundle ships only manifest-declared files, but this repo is
# public, so keep them out of git too.
models/**/*.yaml
